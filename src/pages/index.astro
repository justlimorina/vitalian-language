---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  {
    icon: 'volume_up',
    badge: '01 · Âm thanh & Ký tự',
    title: 'Hệ thống Ngữ âm',
    text: 'Bảng chữ cái 26 ký tự, giá trị nguyên âm cổ không qua biến chuyển (No GVS), trọng âm và hệ phụ âm.',
    href: 'docs/standard/phonology/',
  },
  {
    icon: 'auto_stories',
    badge: '02 · Cơ chế ngôn ngữ',
    title: 'Ngữ pháp & Cấu trúc',
    text: 'Trật tự câu SVO/V2, hệ thống đại từ nhân xưng, giống danh từ, biến cách và thì động từ.',
    href: 'docs/standard/grammar/',
  },
  {
    icon: 'menu_book',
    badge: '03 · Căn tố & Cấu từ',
    title: 'Từ vựng & Cấu từ',
    text: 'Cội nguồn Germanic vững chắc kết hợp các lớp từ cung đình Romance, quy tắc tiền tố và hậu tố.',
    href: 'docs/standard/lexicon/',
  },
  {
    icon: 'format_list_numbered',
    badge: '04 · 100 Từ cốt lõi',
    title: 'Bảng từ Swadesh',
    text: 'Danh sách 100 từ vựng căn bản nhất kèm phiên âm quốc tế IPA, nghĩa tiếng Việt và từ nguyên học.',
    href: 'docs/words_list/standard/swadesh_100/',
  },
  {
    icon: 'castle',
    badge: '05 · Dòng chảy thời gian',
    title: 'Bối cảnh lịch sử',
    text: 'Biên niên sử 4 thời kỳ từ Tiền Trung Cổ (160 AD), Kỷ nguyên Morrazalina, 5 thế kỷ Toghman đô hộ, đến Đại Phục quốc và nền Cộng hòa (1622 AD).',
    href: 'docs/historical_backgrounds/vitalia/01-prior-to-middle-ages/',
  },
  {
    icon: 'explore',
    badge: '06 · Vùng miền & Giọng nói',
    title: 'Dạng cổ & Phương ngữ',
    text: 'Tìm hiểu tiếng Vitalia Cổ (Old Vitalian), tiếng Silicania và phương ngữ Limorina đặc trưng.',
    href: 'docs/dialects_and_old_forms/old_vitalian/readme/',
  },
];
---

<SiteLayout title="Khám phá tiếng Vitalia" active="home">
  <!-- Hero Banner (MD3 Surface Container Low) -->
  <section class="hero-banner">
    <div class="hero-badge">
      <span class="material-symbols-outlined hero-badge-icon">auto_awesome</span>
      <span>Dự án Ngôn ngữ Nhân tạo (Conlang) · Thế giới Vitalia</span>
    </div>
    <h1 class="hero-title">Khám phá <em>Vitalische</em></h1>
    <p class="hero-description">
      Một ngôn ngữ được định hình qua hàng thế kỷ lịch sử: từ nền tảng ngữ pháp Germanic cổ xưa kiên cố
      cho đến vẻ đẹp thanh tao của lớp từ vựng Romance cung đình, cùng sự phong phú của các phương ngữ địa phương.
    </p>
    <div class="hero-actions">
      <a class="md3-btn filled" href={`${base}docs/standard/phonology/`}>
        <span class="material-symbols-outlined">menu_book</span>
        <span>Bắt đầu với Ngữ âm</span>
        <span class="material-symbols-outlined">arrow_forward</span>
      </a>
      <a class="md3-btn outlined" href={`${base}docs/words_list/standard/swadesh_100/`}>
        <span class="material-symbols-outlined">format_list_numbered</span>
        <span>Tra cứu bảng từ Swadesh</span>
      </a>
      <a class="md3-btn text" href="https://github.com/justlimorina/vitalian-language" target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined">code</span>
        <span>Mã nguồn GitHub</span>
      </a>
    </div>
  </section>

  <!-- Section Header -->
  <div class="section-title-wrap">
    <span class="material-symbols-outlined section-icon">grid_view</span>
    <h2>Các chủ đề nghiên cứu & tài liệu thực địa</h2>
  </div>

  <!-- Cards Grid (MD3 Outlined / Elevated Cards) -->
  <div class="cards-grid">
    {cards.map((card) => (
      <a class="md3-card" href={`${base}${card.href}`}>
        <div class="card-top">
          <span class="card-icon-wrap">
            <span class="material-symbols-outlined card-icon">{card.icon}</span>
          </span>
          <span class="card-badge">{card.badge}</span>
        </div>
        <div class="card-body">
          <h3 class="card-title">{card.title}</h3>
          <p class="card-text">{card.text}</p>
        </div>
        <div class="card-arrow">
          <span>Xem chi tiết</span>
          <span class="material-symbols-outlined">arrow_forward</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Intro Prose Section -->
  <section class="intro-section">
    <div class="intro-card">
      <div class="intro-header">
        <span class="material-symbols-outlined intro-icon">history_edu</span>
        <h2>Một ngôn ngữ — Nhiều thời kỳ & không gian văn hóa</h2>
      </div>
      <p>
        <strong>Vitalische</strong> (tiếng Vitalia) là ngôn ngữ chính thức và biểu tượng văn hóa của vương quốc Vitalia.
        Ở dạng tiêu chuẩn, ngôn ngữ này lưu giữ phong thái trang trọng với âm hưởng gợi nhớ tiếng Anh trung đại (Middle English),
        trong khi các tầng lớp cổ xưa hơn vẫn duy trì cấu trúc chia thì, biến cách chặt chẽ của các ngữ tộc Germanic lục địa.
      </p>
      <p>
        Trang tài liệu này được biên soạn như một cẩm nang thực địa (field guide) toàn diện: giúp người quan tâm dễ dàng
        tra cứu từ hệ thống nguyên âm - phụ âm, các quy tắc ngữ pháp, bảng từ nguyên học Swadesh cho đến các văn bản mẫu sống động.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  /* ==========================================================================
     Home Page MD3 Styling
     ========================================================================== */
  .hero-banner {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-surface-container-highest);
    border-radius: var(--md-sys-shape-corner-xl);
    padding: 48px 40px;
    margin-bottom: 48px;
    box-shadow: var(--md-sys-elevation-1);
    position: relative;
    overflow: hidden;
  }

  .hero-banner::after {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--md-sys-color-primary-container) 0%, transparent 70%);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .hero-badge-icon {
    font-size: 16px;
    color: var(--md-sys-color-primary);
  }

  .hero-title {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 18px;
    color: var(--md-sys-color-on-surface);
    letter-spacing: -0.02em;
  }

  .hero-title em {
    font-style: italic;
    color: var(--md-sys-color-primary);
    font-family: serif;
    font-weight: 600;
  }

  .hero-description {
    font-size: 17px;
    line-height: 1.7;
    color: var(--md-sys-color-on-surface-variant);
    max-width: 680px;
    margin: 0 0 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* MD3 Styled Buttons */
  .md3-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  .md3-btn.filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    box-shadow: var(--md-sys-elevation-1);
  }

  .md3-btn.filled:hover {
    background: #14592e;
    box-shadow: var(--md-sys-elevation-2);
    transform: translateY(-1px);
  }

  .md3-btn.outlined {
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    color: var(--md-sys-color-primary);
  }

  .md3-btn.outlined:hover {
    background: var(--md-sys-color-surface-container-high);
    border-color: var(--md-sys-color-primary);
  }

  .md3-btn.text {
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    padding: 0 16px;
  }

  .md3-btn.text:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  /* Section Title */
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .section-icon {
    font-size: 22px;
    color: var(--md-sys-color-primary);
  }

  .section-title-wrap h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    color: var(--md-sys-color-on-surface);
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 48px;
  }

  .md3-card {
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1), border-color 0.2s ease;
  }

  .md3-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--md-sys-elevation-2);
    border-color: var(--md-sys-color-primary);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--md-sys-shape-corner-md);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-primary);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .md3-card:hover .card-icon-wrap {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .card-badge {
    font-family: var(--md-sys-typescale-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--md-sys-color-on-surface);
  }

  .card-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 20px;
  }

  .card-arrow {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--md-sys-color-primary);
    margin-top: auto;
  }

  .card-arrow .material-symbols-outlined {
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .md3-card:hover .card-arrow .material-symbols-outlined {
    transform: translateX(4px);
  }

  /* Intro Card */
  .intro-card {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-surface-container-highest);
    border-radius: var(--md-sys-shape-corner-xl);
    padding: 36px 36px 32px;
  }

  .intro-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .intro-icon {
    font-size: 26px;
    color: var(--md-sys-color-primary);
  }

  .intro-header h2 {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    color: var(--md-sys-color-on-surface);
  }

  .intro-card p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--md-sys-color-on-surface-variant);
    margin: 0 0 14px;
  }

  .intro-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 600px) {
    .hero-banner {
      padding: 32px 20px;
      margin-bottom: 32px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .md3-btn {
      width: 100%;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .intro-card {
      padding: 24px 20px;
    }
  }
</style>

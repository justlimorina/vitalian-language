---
import { Marked } from 'marked';
import SiteLayout from '../layouts/SiteLayout.astro';

export function getStaticPaths() {
  const documents = import.meta.glob('../../docs/**/*.md', { query: '?raw', import: 'default', eager: true });
  const samples = import.meta.glob('../../samples/**/*.md', { query: '?raw', import: 'default', eager: true });
  const all = { ...documents, ...samples };
  const entries = Object.entries(all).map(([file, body]) => ({
    file,
    body: body as string,
    slug: file.replace(/^(\.\.\/)+/, '').replace(/\.md$/, ''),
  }));

  return entries.map(({ slug, body, file }) => {
    const match = body.match(/^#\s+(.+)$/m);
    const title = match?.[1]?.replace(/[*_`]/g, '') ?? slug.split('/').at(-1)?.replaceAll('_', ' ') ?? 'Document';
    return { params: { slug }, props: { body, title, file, slug } };
  });
}

const { body, title, file, slug } = Astro.props;
const cleanFile = file.replace(/^(\.\.\/)+/, '');
const base = import.meta.env.BASE_URL;
const active = slug.replace(/\.md$/, '');
const markdown = new Marked({ gfm: true, breaks: false });
markdown.use({
  renderer: {
    link({ href, title: linkTitle, text }) {
      if (!href) return text;
      const [target, fragment] = href.split('#');
      if (target.endsWith('.md')) {
        const resolved = new URL(target, `https://local.invalid/${cleanFile}`);
        const path = resolved.pathname.replace(/\.md$/, '/');
        href = `${base}${path.replace(/^\//, '')}${fragment ? `#${fragment}` : ''}`;
      }
      return `<a href="${href}"${linkTitle ? ` title="${linkTitle}"` : ''}>${text}</a>`;
    },
  },
});
const rendered = await markdown.parse(body);
const section = cleanFile.startsWith('samples/') ? 'Sample texts' : cleanFile.split('/')[1]?.replaceAll('_', ' ') ?? 'Vitalische field guide';
---
<SiteLayout title={title} active={active}>
  <article>
    <header class="document-head"><div class="eyebrow">{section}</div><h1>{title}</h1><p>Vitalische field guide <span>·</span> <a href={`${base}`}>All topics</a></p></header>
    <div class="prose" set:html={rendered} />
  </article>
</SiteLayout>
